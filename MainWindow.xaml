<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="TermKit.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="TermKit">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid Padding="16,12,16,12" RequestedTheme="Dark">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                CornerRadius="6" Padding="12" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                    <StackPanel x:Name="AdConnectionStatus" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Grid Width="8" Height="8">
                            <Ellipse x:Name="AdOfflineIndicator" Stroke="{ThemeResource TextFillColorSecondaryBrush}" StrokeThickness="1" />
                            <Ellipse x:Name="AdOnlineIndicator" Fill="#6EE7A0" Visibility="Collapsed" />
                        </Grid>
                        <TextBlock x:Name="TextBlockAdStatus" Text="AD offline" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <StackPanel x:Name="ExoConnectionStatus" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Grid Width="8" Height="8">
                            <Ellipse x:Name="ExoOfflineIndicator" Stroke="{ThemeResource TextFillColorSecondaryBrush}" StrokeThickness="1" />
                            <Ellipse x:Name="ExoOnlineIndicator" Fill="#6EE7A0" Visibility="Collapsed" />
                        </Grid>
                        <TextBlock x:Name="TextBlockExoStatus" Text="EXO offline" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <StackPanel x:Name="GraphConnectionStatus" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Grid Width="8" Height="8">
                            <Ellipse x:Name="GraphOfflineIndicator" Stroke="{ThemeResource TextFillColorSecondaryBrush}" StrokeThickness="1" />
                            <Ellipse x:Name="GraphOnlineIndicator" Fill="#6EE7A0" Visibility="Collapsed" />
                        </Grid>
                        <TextBlock x:Name="TextBlockGraphStatus" Text="Graph offline" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <Button x:Name="ButtonConnections" Width="32" Height="32" Padding="0" Background="Transparent"
                            ToolTipService.ToolTip="Manage connections" AutomationProperties.Name="Manage connections">
                        <SymbolIcon Symbol="World" Width="20" Height="20" />
                        <Button.Flyout>
                            <MenuFlyout>
                                <MenuFlyoutItem x:Name="ButtonConnectAd" Text="Connect Active Directory..." Icon="Contact" Click="ButtonConnectAd_Click" />
                                <MenuFlyoutItem x:Name="ButtonConnectExo" Text="Connect Exchange Online" Icon="Mail" Click="ButtonConnectExo_Click" />
                                <MenuFlyoutItem x:Name="ButtonConnectGraph" Text="Connect Microsoft Graph" Icon="People" Click="ButtonConnectGraph_Click" IsEnabled="False" />
                                <MenuFlyoutSeparator />
                                <MenuFlyoutItem x:Name="ButtonDisconnectAd" Text="Disconnect Active Directory" Icon="Remove" Click="ButtonDisconnectAd_Click" IsEnabled="False" />
                                <MenuFlyoutItem x:Name="ButtonForgetAdCredentials" Text="Forget saved AD credentials" Icon="Delete" Click="ButtonForgetAdCredentials_Click" IsEnabled="False" />
                                <MenuFlyoutItem x:Name="ButtonDisconnect" Text="Disconnect All" Icon="Cancel" Click="ButtonDisconnect_Click" />
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button x:Name="ButtonUpdates" Content="Check for updates" Click="ButtonUpdates_Click"
                            ToolTipService.ToolTip="Check the update feed for a newer TermKit" />
                    <Button x:Name="ButtonOpenSettings" Content="Settings" Click="ButtonOpenSettings_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" ColumnSpacing="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" MinWidth="280" />
        </Grid.ColumnDefinitions>

        <ScrollViewer Grid.Column="0" Width="640">
            <StackPanel Spacing="12">
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6" Padding="12">
                    <StackPanel Spacing="10">
                        <TextBlock Text="1. Target User Details" FontWeight="SemiBold" FontSize="15" />
                        <Grid ColumnSpacing="10" RowSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180" />
                                <ColumnDefinition Width="300" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Task # (for Description):" VerticalAlignment="Center" />
                            <TextBox Grid.Row="0" Grid.Column="1" x:Name="TextBoxRetentionTaskNumber" PlaceholderText="TASK0012345" />
                            <Button Grid.Row="0" Grid.Column="2" x:Name="ButtonRetentionLookup" Content="Look up" Click="ButtonRetentionLookup_Click"
                                    ToolTipService.ToolTip="Fill the fields below from the ServiceNow task using the service account" />

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Term User (Sam/UPN):" VerticalAlignment="Center" />
                            <TextBox Grid.Row="1" Grid.Column="1" x:Name="TextBoxRetentionTargetUser" PlaceholderText="user@contoso.com" />

                            <TextBlock Grid.Row="2" Grid.Column="0" x:Name="TextBlockRetentionDelegateLabel" Text="Delegate (Sam/UPN):" VerticalAlignment="Center" />
                            <TextBox Grid.Row="2" Grid.Column="1" x:Name="TextBoxRetentionDelegateUser" PlaceholderText="delegate@contoso.com" />

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Retention End Date:" VerticalAlignment="Center" />
                            <TextBox Grid.Row="3" Grid.Column="1" x:Name="TextBoxRetentionEndDate" PlaceholderText="MM/DD/YYYY" />
                            <CheckBox Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2" x:Name="CheckBoxNoRetention" Content="No email retention needed"
                                      Checked="CheckBoxNoRetention_Changed" Unchecked="CheckBoxNoRetention_Changed"
                                      ToolTipService.ToolTip="Uses tomorrow as the end date and makes the delegate optional" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6" Padding="12">
                    <StackPanel Spacing="10">
                        <TextBlock Text="2. Action" FontWeight="SemiBold" FontSize="15" />
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Button x:Name="ButtonRetentionProcess" Content="Process User Conversion" Style="{StaticResource AccentButtonStyle}" IsEnabled="False" Click="ButtonRetentionProcess_Click" />
                            <Button x:Name="ButtonRetentionCopySummary" Content="Copy Summary" Click="ButtonRetentionCopySummary_Click" IsEnabled="False" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <TextBlock x:Name="TextBlockRetentionStatus" Text="Status: Idle" Opacity="0.8" TextWrapping="Wrap" />
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" Margin="0,0,0,4">
                <CheckBox x:Name="CheckBoxShowWarnings" Content="Show Warnings" VerticalAlignment="Center" Checked="CheckBoxShowWarnings_Changed" Unchecked="CheckBoxShowWarnings_Changed" />
            </StackPanel>
            <Border Grid.Row="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="4">
                <ScrollViewer x:Name="LogScrollViewer" VerticalScrollBarVisibility="Auto" VerticalAlignment="Stretch">
                    <TextBlock x:Name="TextBlockLog" TextWrapping="Wrap" Padding="8,8,8,20" FontFamily="Consolas" FontSize="12" IsTextSelectionEnabled="True" />
                </ScrollViewer>
            </Border>
        </Grid>
        </Grid>
    </Grid>
</Window>
